{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "rootDir": "src",           // Define explicitamente o ponto de partida do código-fonte
    "baseUrl": "./",
    "types": ["zone.js"]        // Força o TypeScript a carregar as declarações do zone.js
  },
  "files": [
    "src/main.ts"
  ],
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts"
  ],
  "exclude": [
    "src/**/*.spec.ts",
    "node_modules",
    "*.ts" // IMPEDE que arquivos soltos na raiz (ex: angular.config.ts) entrem na árvore do App
  ]
}
